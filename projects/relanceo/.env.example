# Copiez ce fichier en .env (jamais commité) ou saisissez ces variables chez votre hébergeur.
APP_URL=https://votre-domaine.fr
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
TRUST_PROXY=true
CRON_SECRET=une-longue-valeur-aleatoire

# Paiement (générées par : npm run stripe:setup)
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# E-mails (bienvenue, mot de passe oublié, invitations, relances)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM="RELANCEO <noreply@votre-domaine.fr>"

# Relances automatiques (Business) : laisser à false tant que l'envoi d'e-mails n'est pas vérifié
AUTOMATIONS_ENABLED=false
# REPLY_DOMAIN=reponses.votre-domaine.fr
# INBOUND_WEBHOOK_SECRET=...

# Assistance IA (Pro et Business)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5

# SUPPORT_PROCESS_READY=true
